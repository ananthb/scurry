# systemd --user unit for the scurry daemon.
#
# Installed to ~/.config/systemd/user/scurry.service, then:
#   systemctl --user enable --now scurry
#
# User scope, not system: the daemon captures input from a graphical session
# and needs that session's environment. A system unit has no seat to read from.

[Unit]
Description=scurry input daemon
Documentation=https://github.com/ananthb/scurry
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/scurry-ctl run
Restart=on-failure
RestartSec=10

# The daemon needs read/write access to the dongle's USB CDC node. On most
# distributions that means membership of the dialout or uucp group; a udev rule
# is the alternative when adding the user to a group is unwelcome.
# SupplementaryGroups=dialout

[Install]
WantedBy=graphical-session.target
