# Unanchored so it matches nested crates too: crates/scurry-ffi builds its own
# target/ as a separate workspace, and an anchored /target missed it entirely.
target/
result
result-*
.direnv
.cargo-tools
/firmware/**/build
/firmware/**/sdkconfig
/firmware/**/sdkconfig.old
/firmware/**/managed_components
scurry.toml
