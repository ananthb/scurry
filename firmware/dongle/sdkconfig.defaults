# NimBLE, not Bluedroid: smaller, and the HID peripheral role is better trodden.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# The entire point of the spike. If concurrent bonded HID connections do not
# hold, switching costs a reconnect (~200ms-2s) and the architecture is dead.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# Persist bonds across reboots so targets are paired once, not every boot.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=8

# Ask for the tightest connection interval the spec allows. Hosts are free to
# refuse: macOS clamps to >=15ms. Measuring what we actually get is the second
# thing this spike is for.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
